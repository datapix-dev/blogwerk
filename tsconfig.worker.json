{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  },
  "include": ["worker/**/*.ts", "lib/redis.ts", "lib/ai/**/*.ts", "lib/adapters/**/*.ts"],
  "exclude": ["node_modules", ".next", "app", "components"]
}
